rules_version = '2';
service cloud.firestore { match /databases/{db}/documents { match /lobbies/{code} { allow get: if request.auth != null; allow list: if false; allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid; allow update: if request.auth != null && resource.data.hostUid == request.auth.uid && request.resource.data.hostUid == resource.data.hostUid; allow delete: if false; } } }
